#!/bin/bash
# Mock sbatch — records the invocation and returns a fake job id.
#
# Does NOT execute the submitted job script. Real sbatch submission is
# asynchronous (the job runs later, elsewhere, on compute nodes); testing
# what happens once the job actually runs is done separately, in the
# "compute" sandbox profile, by invoking the compute-side scripts
# (slurm-vllm-serve.sh, run_head_vllm.sh, ...) directly — see
# tests/bash/sandboxed/. This shim only validates that the LOGIN-side
# orchestration script (ivllm-serve.sh) builds the expected sbatch
# invocation and correctly handles its result (job id / exit code).
#
# Configure via:
#   MOCK_SBATCH_JOB_ID   fake numeric job id to return (default: 424242)
#   MOCK_SBATCH_EXIT      exit code to return (default: 0)
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_shim-common.sh"

shim_log sbatch "$*"

job_id="${MOCK_SBATCH_JOB_ID:-424242}"
exit_code="${MOCK_SBATCH_EXIT:-0}"

if [[ "$exit_code" -eq 0 ]]; then
    # Real sbatch --parsable prints only the bare job id to stdout — every
    # call site in this codebase uses --parsable, so that's all we emit.
    echo "$job_id"
else
    echo "sbatch: error: mock failure (MOCK_SBATCH_EXIT=$exit_code)" >&2
fi

exit "$exit_code"
