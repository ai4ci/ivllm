#!/bin/bash
# Mock hf CLI (huggingface_hub). Supports the two invocations this codebase
# uses:
#   hf cache ls --format json  — lists cached models as a JSON array of
#                                 {"repo_id": ...} objects (see
#                                 ivllm-get-model.sh's `jq -e '.[] |
#                                 select(.repo_id == "$HF_MODEL")'`)
#   hf download <model>         — downloads a model
#
# Configure via:
#   MOCK_HF_CACHED_MODELS    space-separated model ids already "cached"
#                             (default: none)
#   MOCK_HF_DOWNLOAD_EXIT     exit code for `hf download` (default: 0)
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_shim-common.sh"

shim_log hf "$*"

sub="${1:-}"
shift || true

case "$sub" in
    cache)
        # hf cache ls --format json — emit a JSON array of {"repo_id": ...}
        # entries, matching real `hf cache ls --format json` output shape.
        entries=()
        for m in ${MOCK_HF_CACHED_MODELS:-}; do
            entries+=("{\"repo_id\": \"$m\"}")
        done
        printf '[%s]' "$(IFS=,; echo "${entries[*]:-}")"
        exit 0
        ;;
    download)
        model="${1:-}"
        exit_code="${MOCK_HF_DOWNLOAD_EXIT:-0}"
        if [[ "$exit_code" -eq 0 ]]; then
            echo "[mock hf] downloaded $model"
        else
            echo "[mock hf] download failed for $model" >&2
        fi
        exit "$exit_code"
        ;;
    *)
        echo "[mock hf] unsupported subcommand: $sub" >&2
        exit 1
        ;;
esac
